# PromptBlame settings. Copy this file to `.env` (which git ignores) and fill in
# what you need: the UI (`promptblame` / `streamlit run app.py`), the CLI and the
# REST API load it automatically from the working directory. Variables already
# set in the environment take precedence over the file.
#
# Copia este fichero a `.env` (git lo ignora) y rellena lo que necesites: la
# interfaz, la CLI y la API REST lo cargan solas desde el directorio de trabajo.
# Las variables ya definidas en el entorno tienen prioridad sobre el fichero.

# --- API keys (only the providers you use) ---------------------------------------
# Keys are read on the server and are never sent to the browser.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# OpenAI-compatible endpoint (Ollama, OpenRouter, Mistral, Groq, vLLM…)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1

# --- Default models ----------------------------------------------------------------
# Providers: anthropic | openai | gemini | compatible
# Efforts:   low | medium | high | xhigh | max
# The service generates the response and the ablation runs; the judge attributes
# and rewrites. Leave a model empty to use the provider's default.
PROMPTBLAME_SERVICE_PROVIDER=anthropic
PROMPTBLAME_SERVICE_MODEL=claude-opus-5-5
PROMPTBLAME_SERVICE_EFFORT=medium
PROMPTBLAME_JUDGE_PROVIDER=anthropic
PROMPTBLAME_JUDGE_MODEL=claude-opus-5-5
PROMPTBLAME_JUDGE_EFFORT=high

# --- Other defaults ----------------------------------------------------------------
# UI language (en | es). Empty = the browser's.
PROMPTBLAME_LANGUAGE=
# Verify attributions by ablation by default (true | false) and how many
# instructions to ablate at most (1-30).
PROMPTBLAME_ABLATION=false
PROMPTBLAME_MAX_ABLATION=8

# --- REST API (`promptblame serve`) ------------------------------------------------
# If set, every endpoint except /health requires `Authorization: Bearer <token>`.
# Set it whenever the API listens on anything other than 127.0.0.1.
PROMPTBLAME_API_TOKEN=
